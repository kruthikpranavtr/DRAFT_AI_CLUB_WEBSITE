PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_PATH=server/data/ai-club-cms.db
UPLOAD_DIR=server/uploads
MAX_UPLOAD_BYTES=104857600

# Required on the first production start. Change immediately after provisioning.
BOOTSTRAP_ADMIN_ID=ADMIN-01
BOOTSTRAP_ADMIN_EMAIL=admin@srishakthi.ac.in
BOOTSTRAP_ADMIN_NAME=Club Administrator
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_STUDENT_ID=SSAC-2026-014
BOOTSTRAP_STUDENT_EMAIL=student@srishakthi.ac.in
BOOTSTRAP_STUDENT_NAME=AI Club Student
BOOTSTRAP_STUDENT_PASSWORD=

# S3-compatible object storage (Railway Bucket, AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
