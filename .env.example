PORT=3002
NODE_ENV=development
VITE_WEB_PORT=5174
VITE_WEB_HOST=127.0.0.1
VITE_API_PORT=3002
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
DATABASE_PATH=server/data/ai-club-member-platform.db
MIGRATION_BACKUP_DIR=server/data/member-platform-backups
UPLOAD_DIR=server/member-platform-uploads
MAX_UPLOAD_BYTES=104857600

# Optional local fallback for homepage videos when S3 is not configured.
MEDIA_FALLBACK_BASE_URL=

# Required only when the corresponding bootstrap account does not already exist.
# Never commit a real password or reuse these temporary credentials elsewhere.
BOOTSTRAP_ADMIN_ID=ADMIN-01
BOOTSTRAP_ADMIN_EMAIL=admin@srishakthi.ac.in
BOOTSTRAP_ADMIN_NAME=Club Administrator
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_STUDENT_ID=SSAC-2026-014
BOOTSTRAP_STUDENT_EMAIL=student@srishakthi.ac.in
BOOTSTRAP_STUDENT_NAME=AI Club Student
BOOTSTRAP_STUDENT_PASSWORD=

# S3-compatible object storage (Railway Bucket, AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
